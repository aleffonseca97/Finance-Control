DATABASE_URL="postgresql://user:password@url:port/SCHEMA?schema=public"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# E-mail (Resend) — https://resend.com
RESEND_API_KEY=""
# Ex.: Logos Finance <onboarding@seudominio.com> (domínio verificado no Resend)
EMAIL_FROM=""
# Opcional; se vazio, usa NEXTAUTH_URL nos links dos e-mails
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — https://dashboard.stripe.com
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Monthly subscription prices by locale (pt-BR→BRL, en→USD, it→EUR)
STRIPE_PRICE_ID_BRL=""
STRIPE_PRICE_ID_USD=""
STRIPE_PRICE_ID_EUR=""
# Optional fallback for BRL if STRIPE_PRICE_ID_BRL is unset
# STRIPE_PRICE_ID=""

# Testes: copie .env.test.example → .env.test (DB dedicado) e rode:
#   npm run db:migrate:test
#   npm test
#   npm run test:e2e
